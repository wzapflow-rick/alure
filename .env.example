# ALURE OS — variáveis de ambiente
# Cadastre os valores reais na Vercel (Settings → Environment Variables).
# Nunca coloque valores reais neste arquivo.

# Banco (PostgreSQL via PgBouncer, porta 5433 com SSL)
DATABASE_URL=postgresql://alure:SENHA@db-integrator.wzapflow.com.br:5433/alure?sslmode=require
# Opcional: força o modo SSL (require | disable). Normalmente deixe vazio.
DATABASE_SSL=

# Autenticação (Better Auth)
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
# Opcional: URL pública do app. Na Vercel é detectada sozinha.
BETTER_AUTH_URL=
# E-mails que podem entrar, separados por vírgula
ALURE_ALLOWED_EMAILS=voce@alure.com.br

# Criptografia dos tokens OAuth dos marketplaces (32 bytes em base64).
# NÃO troque depois de conectar os marketplaces.
TOKEN_ENCRYPTION_KEY=gere-com-openssl-rand-base64-32

# Mercado Livre
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://alure-six.vercel.app/api/integrations/mercado-livre/callback
# true somente se o PKCE estiver ativado no app do Mercado Livre
MELI_PKCE=

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=https://alure-six.vercel.app/api/integrations/shopee/callback
# Opcional: deixe vazio para produção
SHOPEE_HOST=

# Sincronização diária (cron da Vercel)
CRON_SECRET=gere-com-openssl-rand-base64-32

# IA: o assistente usa o Vercel AI Gateway, autenticado automaticamente
# na Vercel. Não é preciso OPENAI_API_KEY.
